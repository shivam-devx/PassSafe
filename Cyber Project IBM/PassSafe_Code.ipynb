            "source": [
                "==============================================================\n",
                "  PassSafe — Password Security Checker\n",
                "  Complete Source Code (synced from the project files)\n",
                "==============================================================\n",
                "  Files included: index.html, style.css, and script.js\n",
                "  Project author: Shivam Dohare\n",
                "  All password processing is local to the browser.\n",
                "\n",
                "\n",
                "================================================================\n",
                "  FILE — index.html\n",
                "================================================================\n",
                "\n",
                "<!DOCTYPE html>\n",
                "<html lang=\"en\">\n",
                "<head>\n",
                "  <meta charset=\"UTF-8\" />\n",
                "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n",
                "  <title>PassSafe — Password Security Checker</title>\n",
                "  <link rel=\"stylesheet\" href=\"style.css\" />\n",
                "</head>\n",
                "<body>\n",
                "\n",
                "  <!-- Header / Logo -->\n",
                "  <header>\n",
                "    <div class=\"logo\">\n",
                "      <svg class=\"shield-icon\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n",
                "        <path d=\"M12 2L3 6v6c0 5.25 3.75 10.15 9 11.25C17.25 22.15 21 17.25 21 12V6L12 2z\"\n",
                "          fill=\"#00e676\" stroke=\"#00e676\" stroke-width=\"0.5\"/>\n",
                "        <path d=\"M9 12l2 2 4-4\" stroke=\"#0d1b2a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n",
                "      </svg>\n",
                "      <span>PassSafe</span>\n",
                "    </div>\n",
                "    <p class=\"tagline\">Password Security Lab</p>\n",
                "  </header>\n",
                "\n",
                "  <main>\n",
                "\n",
                "    <!-- Password Strength Checker Card -->\n",
                "    <section class=\"card\" id=\"checker-card\">\n",
                "      <h2>Password Strength Checker</h2>\n",
                "      <p class=\"card-desc\">Get a basic estimate. Passwords are not checked against breach databases.</p>\n",
                "\n",
                "      <div class=\"input-row\">\n",
                "        <input type=\"password\" id=\"password-input\" placeholder=\"Enter your password...\" autocomplete=\"off\" aria-label=\"Password to check\" />\n",
                "        <button type=\"button\" class=\"icon-btn\" id=\"toggle-btn\" title=\"Show password\" aria-label=\"Show password\" aria-pressed=\"false\">👁</button>\n",
                "      </div>\n",
                "\n",
                "      <button class=\"btn primary\" id=\"check-btn\">Check Password</button>\n",
                "\n",
                "      <!-- Result area (hidden until checked) -->\n",
                "      <div id=\"result-area\" class=\"hidden\">\n",
                "        <div class=\"strength-bar-wrap\">\n",
                "          <div class=\"strength-bar\" id=\"strength-bar\"></div>\n",
                "        </div>\n",
                "        <p id=\"strength-label\" role=\"status\" aria-live=\"polite\"></p>\n",
                "        <ul id=\"suggestions\"></ul>\n",
                "      </div>\n",
                "    </section>\n",
                "\n",
                "    <!-- Password Generator Card -->\n",
                "    <section class=\"card\" id=\"generator-card\">\n",
                "      <h2>Password Generator</h2>\n",
                "      <p class=\"card-desc\">Generate a strong random password instantly.</p>\n",
                "\n",
                "      <button class=\"btn primary\" id=\"generate-btn\">Generate Password</button>\n",
                "\n",
                "      <!-- Generated password display (hidden until generated) -->\n",
                "      <div id=\"gen-result\" class=\"hidden\">\n",
                "        <div class=\"gen-output-row\">\n",
                "          <span id=\"gen-password\"></span>\n",
                "          <button type=\"button\" class=\"icon-btn\" id=\"copy-btn\" title=\"Copy password\" aria-label=\"Copy generated password\">📋</button>\n",
                "        </div>\n",
                "        <p id=\"copy-msg\" class=\"copy-msg hidden\" role=\"status\" aria-live=\"polite\">Copied!</p>\n",
                "      </div>\n",
                "    </section>\n",
                "\n",
                "    <!-- Security Tips Card -->\n",
                "    <section class=\"card\" id=\"tips-card\">\n",
                "      <h2>Password Security Tips</h2>\n",
                "      <ul class=\"tips-list\">\n",
                "        <li>\n",
                "          <span class=\"tip-icon\">🔒</span>\n",
                "          <span>Use long passwords — at least 12 characters.</span>\n",
                "        </li>\n",
                "        <li>\n",
                "          <span class=\"tip-icon\">🚫</span>\n",
                "          <span>Avoid common words, names, and predictable patterns like \"123456\".</span>\n",
                "        </li>\n",
                "        <li>\n",
                "          <span class=\"tip-icon\">🔁</span>\n",
                "          <span>Never reuse the same password across different accounts.</span>\n",
                "        </li>\n",
                "        <li>\n",
                "          <span class=\"tip-icon\">🗝</span>\n",
                "          <span>Use a password manager to store passwords safely.</span>\n",
                "        </li>\n",
                "        <li>\n",
                "          <span class=\"tip-icon\">✅</span>\n",
                "          <span>Enable two-factor authentication (2FA) wherever possible.</span>\n",
                "        </li>\n",
                "      </ul>\n",
                "    </section>\n",
                "\n",
                "  </main>\n",
                "\n",
                "  <footer>\n",
                "    <p>PassSafe &mdash; Password Security Lab &nbsp;|&nbsp; Passwords are never saved or transmitted.</p>\n",
                "  </footer>\n",
                "\n",
                "  <script src=\"script.js\"></script>\n",
                "</body>\n",
                "</html>\n",
                "\n",
                "================================================================\n",
                "  FILE — style.css\n",
                "================================================================\n",
                "\n",
                "/* ===== RESET & BASE ===== */\n",
                "* {\n",
                "  margin: 0;\n",
                "  padding: 0;\n",
                "  box-sizing: border-box;\n",
                "}\n",
                "\n",
                ":root {\n",
                "  color-scheme: light;\n",
                "  --page-bg: #f4f7fb;\n",
                "  --surface: #ffffff;\n",
                "  --surface-muted: #f8fafc;\n",
                "  --text: #172b4d;\n",
                "  --text-muted: #66758b;\n",
                "  --border: #e3eaf2;\n",
                "  --accent: #087f5b;\n",
                "  --accent-hover: #066b4d;\n",
                "  --accent-soft: #e7f6ef;\n",
                "  --focus-ring: rgba(8, 127, 91, 0.2);\n",
                "}\n",
                "\n",
                "body {\n",
                "  background:\n",
                "    radial-gradient(ellipse at 50% 0, #eaf4f1 0, transparent 34rem),\n",
                "    var(--page-bg);\n",
                "  color: var(--text);\n",
                "  font-family: \"Segoe UI\", Arial, sans-serif;\n",
                "  font-size: 15px;\n",
                "  line-height: 1.6;\n",
                "  min-height: 100vh;\n",
                "  display: flex;\n",
                "  flex-direction: column;\n",
                "  align-items: center;\n",
                "}\n",
                "\n",
                "/* ===== HEADER ===== */\n",
                "header {\n",
                "  text-align: center;\n",
                "  padding: 38px 20px 8px;\n",
                "}\n",
                "\n",
                ".logo {\n",
                "  display: flex;\n",
                "  align-items: center;\n",
                "  justify-content: center;\n",
                "  gap: 10px;\n",
                "}\n",
                "\n",
                ".shield-icon {\n",
                "  width: 42px;\n",
                "  height: 42px;\n",
                "}\n",
                "\n",
                ".logo span {\n",
                "  font-size: 1.9rem;\n",
                "  font-weight: 700;\n",
                "  color: var(--text);\n",
                "  letter-spacing: -0.6px;\n",
                "}\n",
                "\n",
                ".tagline {\n",
                "  color: var(--text-muted);\n",
                "  font-size: 0.9rem;\n",
                "  margin-top: 2px;\n",
                "}\n",
                "\n",
                "/* ===== MAIN CONTENT ===== */\n",
                "main {\n",
                "  width: 100%;\n",
                "  max-width: 1000px;\n",
                "  padding: 24px 20px 40px;\n",
                "  display: grid;\n",
                "  grid-template-columns: repeat(2, minmax(0, 1fr));\n",
                "  align-content: start;\n",
                "  gap: 20px;\n",
                "}\n",
                "\n",
                "/* ===== CARD ===== */\n",
                ".card {\n",
                "  background-color: var(--surface);\n",
                "  border: 1px solid var(--border);\n",
                "  border-radius: 16px;\n",
                "  padding: 26px;\n",
                "  box-shadow: 0 8px 24px rgba(25, 45, 75, 0.05);\n",
                "  transition: box-shadow 0.2s ease, transform 0.2s ease;\n",
                "}\n",
                "\n",
                ".card:hover {\n",
                "  box-shadow: 0 12px 30px rgba(25, 45, 75, 0.08);\n",
                "  transform: translateY(-2px);\n",
                "}\n",
                "\n",
                ".card h2 {\n",
                "  color: var(--text);\n",
                "  font-size: 1.12rem;\n",
                "  font-weight: 650;\n",
                "  letter-spacing: -0.2px;\n",
                "  margin-bottom: 5px;\n",
                "}\n",
                "\n",
                ".card-desc {\n",
                "  color: var(--text-muted);\n",
                "  font-size: 0.9rem;\n",
                "  margin-bottom: 20px;\n",
                "}\n",
                "\n",
                "#tips-card {\n",
                "  grid-column: 1 / -1;\n",
                "}\n",
                "\n",
                "/* ===== INPUT ROW ===== */\n",
                ".input-row {\n",
                "  display: flex;\n",
                "  gap: 9px;\n",
                "  margin-bottom: 14px;\n",
                "}\n",
                "\n",
                ".input-row input {\n",
                "  flex: 1;\n",
                "  min-width: 0;\n",
                "  background: var(--surface-muted);\n",
                "  border: 1px solid var(--border);\n",
                "  border-radius: 10px;\n",
                "  color: var(--text);\n",
                "  font: inherit;\n",
                "  font-size: 0.94rem;\n",
                "  padding: 11px 14px;\n",
                "  outline: none;\n",
                "  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\n",
                "}\n",
                "\n",
                ".input-row input::placeholder {\n",
                "  color: #8996a8;\n",
                "}\n",
                "\n",
                ".input-row input:focus {\n",
                "  background: var(--surface);\n",
                "  border-color: var(--accent);\n",
                "  box-shadow: 0 0 0 3px var(--focus-ring);\n",
                "}\n",
                "\n",
                "/* ===== BUTTONS ===== */\n",
                ".btn {\n",
                "  display: inline-block;\n",
                "  border: none;\n",
                "  border-radius: 10px;\n",
                "  cursor: pointer;\n",
                "  font: inherit;\n",
                "  font-size: 0.94rem;\n",
                "  font-weight: 650;\n",
                "  padding: 11px 22px;\n",
                "  transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;\n",
                "}\n",
                "\n",
                ".btn:hover {\n",
                "  transform: translateY(-1px);\n",
                "}\n",
                "\n",
                ".btn:active {\n",
                "  transform: translateY(0);\n",
                "}\n",
                "\n",
                ".btn.primary {\n",
                "  background-color: var(--accent);\n",
                "  color: #ffffff;\n",
                "  width: 100%;\n",
                "}\n",
                "\n",
                ".btn.primary:hover {\n",
                "  background-color: var(--accent-hover);\n",
                "  box-shadow: 0 5px 12px rgba(8, 127, 91, 0.18);\n",
                "}\n",
                "\n",
                ".icon-btn {\n",
                "  background: var(--surface-muted);\n",
                "  border: 1px solid var(--border);\n",
                "  border-radius: 10px;\n",
                "  color: var(--text);\n",
                "  cursor: pointer;\n",
                "  font-size: 1rem;\n",
                "  min-width: 44px;\n",
                "  padding: 8px 12px;\n",
                "  transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;\n",
                "}\n",
                "\n",
                ".icon-btn:hover {\n",
                "  background: var(--accent-soft);\n",
                "  border-color: #a8d8c2;\n",
                "}\n",
                "\n",
                "button:focus-visible {\n",
                "  outline: 3px solid var(--focus-ring);\n",
                "  outline-offset: 2px;\n",
                "}\n",
                "\n",
                "/* ===== STRENGTH BAR ===== */\n",
                ".strength-bar-wrap {\n",
                "  background: #edf1f5;\n",
                "  border-radius: 999px;\n",
                "  height: 9px;\n",
                "  margin-top: 18px;\n",
                "  overflow: hidden;\n",
                "}\n",
                "\n",
                ".strength-bar {\n",
                "  height: 100%;\n",
                "  width: 0%;\n",
                "  border-radius: 999px;\n",
                "  transition: width 0.4s ease, background-color 0.4s ease;\n",
                "}\n",
                "\n",
                ".strength-bar.weak   { background-color: #dc4c4c; width: 33%; }\n",
                ".strength-bar.medium { background-color: #e69a24; width: 66%; }\n",
                ".strength-bar.strong { background-color: var(--accent); width: 100%; }\n",
                "\n",
                "#strength-label {\n",
                "  margin-top: 10px;\n",
                "  font-weight: 700;\n",
                "  font-size: 1rem;\n",
                "}\n",
                "\n",
                "#strength-label.weak   { color: #c63838; }\n",
                "#strength-label.medium { color: #a96a08; }\n",
                "#strength-label.strong { color: var(--accent); }\n",
                "\n",
                "#suggestions {\n",
                "  margin-top: 10px;\n",
                "  padding-left: 19px;\n",
                "  color: var(--text-muted);\n",
                "  font-size: 0.88rem;\n",
                "}\n",
                "\n",
                "#suggestions li {\n",
                "  margin-bottom: 4px;\n",
                "}\n",
                "\n",
                "/* ===== GENERATOR OUTPUT ===== */\n",
                ".gen-output-row {\n",
                "  display: flex;\n",
                "  align-items: center;\n",
                "  gap: 10px;\n",
                "  background: var(--surface-muted);\n",
                "  border: 1px solid var(--border);\n",
                "  border-radius: 10px;\n",
                "  padding: 10px 12px 10px 14px;\n",
                "  margin-top: 16px;\n",
                "  word-break: break-all;\n",
                "}\n",
                "\n",
                "#gen-password {\n",
                "  flex: 1;\n",
                "  font-family: \"Courier New\", monospace;\n",
                "  font-size: 0.95rem;\n",
                "  color: var(--accent);\n",
                "  letter-spacing: 0.3px;\n",
                "}\n",
                "\n",
                ".copy-msg {\n",
                "  color: var(--accent);\n",
                "  font-size: 0.82rem;\n",
                "  margin-top: 6px;\n",
                "  text-align: right;\n",
                "}\n",
                "\n",
                ".copy-msg.copy-error {\n",
                "  color: #c63838;\n",
                "}\n",
                "\n",
                "/* ===== TIPS LIST ===== */\n",
                ".tips-list {\n",
                "  list-style: none;\n",
                "  display: grid;\n",
                "  grid-template-columns: repeat(2, minmax(0, 1fr));\n",
                "  gap: 12px;\n",
                "  margin-top: 12px;\n",
                "}\n",
                "\n",
                ".tips-list li {\n",
                "  display: flex;\n",
                "  align-items: flex-start;\n",
                "  gap: 11px;\n",
                "  background: var(--surface-muted);\n",
                "  border: 1px solid #edf1f5;\n",
                "  border-radius: 11px;\n",
                "  padding: 12px 14px;\n",
                "}\n",
                "\n",
                ".tip-icon {\n",
                "  font-size: 1.05rem;\n",
                "  flex-shrink: 0;\n",
                "  margin-top: 1px;\n",
                "}\n",
                "\n",
                "/* ===== FOOTER ===== */\n",
                "footer {\n",
                "  color: var(--text-muted);\n",
                "  font-size: 0.78rem;\n",
                "  padding: 12px 20px 24px;\n",
                "  text-align: center;\n",
                "  margin-top: auto;\n",
                "}\n",
                "\n",
                "/* ===== UTILITY ===== */\n",
                ".hidden {\n",
                "  display: none;\n",
                "}\n",
                "\n",
                "/* ===== RESPONSIVE ===== */\n",
                "@media (max-width: 680px) {\n",
                "  main {\n",
                "    max-width: 540px;\n",
                "    grid-template-columns: 1fr;\n",
                "    gap: 16px;\n",
                "    padding: 22px 16px 32px;\n",
                "  }\n",
                "\n",
                "  #tips-card {\n",
                "    grid-column: auto;\n",
                "  }\n",
                "\n",
                "  .tips-list {\n",
                "    grid-template-columns: 1fr;\n",
                "  }\n",
                "}\n",
                "\n",
                "@media (max-width: 480px) {\n",
                "  header {\n",
                "    padding-top: 28px;\n",
                "  }\n",
                "\n",
                "  .logo span {\n",
                "    font-size: 1.65rem;\n",
                "  }\n",
                "\n",
                "  .shield-icon {\n",
                "    width: 38px;\n",
                "    height: 38px;\n",
                "  }\n",
                "\n",
                "  .card {\n",
                "    padding: 22px 18px;\n",
                "  }\n",
                "}\n",
                "\n",
                "@media (prefers-reduced-motion: reduce) {\n",
                "  *,\n",
                "  *::before,\n",
                "  *::after {\n",
                "    scroll-behavior: auto !important;\n",
                "    transition-duration: 0.01ms !important;\n",
                "    animation-duration: 0.01ms !important;\n",
                "    animation-iteration-count: 1 !important;\n",
                "  }\n",
                "}\n",
                "\n",
                "================================================================\n",
                "  FILE — script.js\n",
                "================================================================\n",
                "\n",
                "// ============================================================\n",
                "// PassSafe — Password Security Checker\n",
                "// script.js  |  All logic runs locally. Nothing is saved.\n",
                "// ============================================================\n",
                "\n",
                "\n",
                "// ── Get references to the HTML elements we need ──────────────\n",
                "const passwordInput = document.getElementById('password-input');\n",
                "const toggleBtn     = document.getElementById('toggle-btn');\n",
                "const checkBtn      = document.getElementById('check-btn');\n",
                "const resultArea    = document.getElementById('result-area');\n",
                "const strengthBar   = document.getElementById('strength-bar');\n",
                "const strengthLabel = document.getElementById('strength-label');\n",
                "const suggestionsList = document.getElementById('suggestions');\n",
                "\n",
                "const generateBtn  = document.getElementById('generate-btn');\n",
                "const genResult    = document.getElementById('gen-result');\n",
                "const genPassword  = document.getElementById('gen-password');\n",
                "const copyBtn      = document.getElementById('copy-btn');\n",
                "const copyMsg      = document.getElementById('copy-msg');\n",
                "\n",
                "\n",
                "// ── SHOW / HIDE PASSWORD ─────────────────────────────────────\n",
                "// Toggle the input between type=\"password\" and type=\"text\"\n",
                "toggleBtn.addEventListener('click', function () {\n",
                "  if (passwordInput.type === 'password') {\n",
                "    passwordInput.type = 'text';\n",
                "    toggleBtn.textContent = '🙈';\n",
                "    toggleBtn.setAttribute('aria-label', 'Hide password');\n",
                "    toggleBtn.title = 'Hide password';\n",
                "    toggleBtn.setAttribute('aria-pressed', 'true');\n",
                "  } else {\n",
                "    passwordInput.type = 'password';\n",
                "    toggleBtn.textContent = '👁';\n",
                "    toggleBtn.setAttribute('aria-label', 'Show password');\n",
                "    toggleBtn.title = 'Show password';\n",
                "    toggleBtn.setAttribute('aria-pressed', 'false');\n",
                "  }\n",
                "});\n",
                "\n",
                "\n",
                "// ── CHECK PASSWORD STRENGTH ──────────────────────────────────\n",
                "checkBtn.addEventListener('click', function () {\n",
                "  const password = passwordInput.value;\n",
                "\n",
                "  // If the field is empty, do nothing\n",
                "  if (password.length === 0) {\n",
                "    alert('Please enter a password first.');\n",
                "    return;\n",
                "  }\n",
                "\n",
                "  // Analyse the password and get a result object\n",
                "  const result = analysePassword(password);\n",
                "\n",
                "  // Show the result area\n",
                "  resultArea.classList.remove('hidden');\n",
                "\n",
                "  // Update the strength bar — remove old classes, then add the new one\n",
                "  strengthBar.className = 'strength-bar ' + result.level;\n",
                "\n",
                "  // Update the label text and colour class\n",
                "  strengthLabel.textContent = 'Strength: ' + result.label;\n",
                "  strengthLabel.className   = result.level;\n",
                "\n",
                "  // Populate the suggestions list\n",
                "  suggestionsList.innerHTML = '';   // clear previous suggestions\n",
                "  result.suggestions.forEach(function (tip) {\n",
                "    const li = document.createElement('li');\n",
                "    li.textContent = tip;\n",
                "    suggestionsList.appendChild(li);\n",
                "  });\n",
                "});\n",
                "\n",
                "\n",
                "// ── analysePassword(password) ────────────────────────────────\n",
                "// Returns { level, label, suggestions }\n",
                "// level  : \"weak\" | \"medium\" | \"strong\"\n",
                "// label  : display text shown to the user\n",
                "// suggestions : array of tip strings\n",
                "function analysePassword(password) {\n",
                "  // Count what character types are present\n",
                "  const hasLower   = /[a-z]/.test(password);\n",
                "  const hasUpper   = /[A-Z]/.test(password);\n",
                "  const hasNumber  = /[0-9]/.test(password);\n",
                "  const hasSymbol  = /[^a-zA-Z0-9]/.test(password);   // anything that isn't a letter or digit\n",
                "  const isLong     = password.length >= 12;\n",
                "  const normalizedPassword = password.toLowerCase();\n",
                "  const predictableFragments = [\n",
                "    'password', 'qwerty', 'asdf', 'zxcv', '1234', '2345', '3456',\n",
                "    '4567', '5678', '6789', '9876', '8765', '7654', '6543',\n",
                "    '5432', '4321', 'abcd', 'bcde', 'cdef', 'fedc', 'edcb',\n",
                "    'dcba', 'letmein', 'welcome', 'admin'\n",
                "  ];\n",
                "  const hasPredictablePattern =\n",
                "    predictableFragments.some(function (fragment) {\n",
                "      return normalizedPassword.includes(fragment);\n",
                "    }) || /(.)\\1{3,}/i.test(password);\n",
                "\n",
                "  // Give a point for each satisfied condition\n",
                "  let score = 0;\n",
                "  if (hasLower)  score++;\n",
                "  if (hasUpper)  score++;\n",
                "  if (hasNumber) score++;\n",
                "  if (hasSymbol) score++;\n",
                "  if (isLong)    score++;\n",
                "\n",
                "  // Build a list of suggestions based on what is missing\n",
                "  const suggestions = [];\n",
                "\n",
                "  if (password.length < 8) {\n",
                "    suggestions.push('Make it at least 8 characters long.');\n",
                "  } else if (password.length < 12) {\n",
                "    suggestions.push('Try making it 12+ characters for extra strength.');\n",
                "  }\n",
                "  if (!hasUpper)  suggestions.push('Add at least one uppercase letter (A–Z).');\n",
                "  if (!hasNumber) suggestions.push('Include at least one number (0–9).');\n",
                "  if (!hasSymbol) suggestions.push('Add a special character like !, @, #, or $.');\n",
                "  if (hasPredictablePattern) {\n",
                "    suggestions.push('Avoid common words, sequences, or repeated characters.');\n",
                "  }\n",
                "\n",
                "  // Decide the overall level based on the score\n",
                "  let level, label;\n",
                "\n",
                "  if (score <= 2) {\n",
                "    level = 'weak';\n",
                "    label = '🔴 Weak';\n",
                "    // Always give at least one suggestion for weak passwords\n",
                "    if (suggestions.length === 0) {\n",
                "      suggestions.push('Try mixing uppercase, numbers, and symbols.');\n",
                "    }\n",
                "  } else if (score <= 3) {\n",
                "    level = 'medium';\n",
                "    label = '🟠 Medium';\n",
                "    if (suggestions.length === 0) {\n",
                "      suggestions.push('Good start! Adding symbols or length will make it stronger.');\n",
                "    }\n",
                "  } else {\n",
                "    level = 'strong';\n",
                "    label = '🟢 Strong';\n",
                "    if (suggestions.length === 0) {\n",
                "      suggestions.push('Great password! Remember to keep it unique and private.');\n",
                "    }\n",
                "  }\n",
                "\n",
                "  if (hasPredictablePattern) {\n",
                "    level = 'weak';\n",
                "    label = '🔴 Weak';\n",
                "  }\n",
                "\n",
                "  return { level, label, suggestions };\n",
                "}\n",
                "\n",
                "\n",
                "// ── GENERATE A SECURE RANDOM PASSWORD ───────────────────────\n",
                "// Uses crypto.getRandomValues() — the browser's secure random source\n",
                "generateBtn.addEventListener('click', function () {\n",
                "  const characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()-_=+[]{}';\n",
                "  const length = getRandomInt(12, 20);   // random length between 12 and 20\n",
                "\n",
                "  let password = '';\n",
                "  for (let i = 0; i < length; i++) {\n",
                "    password += characters[getRandomInt(0, characters.length - 1)];\n",
                "  }\n",
                "\n",
                "  // Show the result\n",
                "  genPassword.textContent = password;\n",
                "  genResult.classList.remove('hidden');\n",
                "  copyMsg.classList.add('hidden');   // hide any previous \"Copied!\" message\n",
                "  copyMsg.classList.remove('copy-error');\n",
                "});\n",
                "\n",
                "\n",
                "// ── COPY GENERATED PASSWORD ──────────────────────────────────\n",
                "copyBtn.addEventListener('click', function () {\n",
                "  const text = genPassword.textContent;\n",
                "  if (!text) return;\n",
                "\n",
                "  // Clipboard access is unavailable on some browsers or file origins.\n",
                "  if (!navigator.clipboard || !navigator.clipboard.writeText) {\n",
                "    copyMsg.textContent = 'Copy failed. Please copy the password manually.';\n",
                "    copyMsg.classList.add('copy-error');\n",
                "    copyMsg.classList.remove('hidden');\n",
                "    return;\n",
                "  }\n",
                "\n",
                "  navigator.clipboard.writeText(text).then(function () {\n",
                "    copyMsg.textContent = 'Copied!';\n",
                "    copyMsg.classList.remove('copy-error');\n",
                "    copyMsg.classList.remove('hidden');   // show \"Copied!\" message\n",
                "    // Hide the message after 2 seconds\n",
                "    setTimeout(function () {\n",
                "      copyMsg.classList.add('hidden');\n",
                "    }, 2000);\n",
                "  }).catch(function () {\n",
                "    copyMsg.textContent = 'Copy failed. Please copy the password manually.';\n",
                "    copyMsg.classList.add('copy-error');\n",
                "    copyMsg.classList.remove('hidden');\n",
                "  });\n",
                "});\n",
                "\n",
                "\n",
                "// ── HELPER: getRandomInt(min, max) ───────────────────────────\n",
                "// Returns a whole number between min and max (inclusive)\n",
                "function getRandomInt(min, max) {\n",
                "  const range = max - min + 1;\n",
                "  const randomArr = new Uint32Array(1);\n",
                "  const limit = Math.floor(0x100000000 / range) * range;\n",
                "  let value;\n",
                "\n",
                "  do {\n",
                "    crypto.getRandomValues(randomArr);\n",
                "    value = randomArr[0];\n",
                "  } while (value >= limit);\n",
                "\n",
                "  return min + (value % range);\n",
                "}\n",
                "\n",
